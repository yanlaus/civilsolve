{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civilsolve",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // node:buffer, for @cloudflare/puppeteer (worker/pdf.ts).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret overrides only. API keys are Wrangler secrets in production
  // and live in .dev.vars locally - never put a key in this file.
  //
  // Empty on purpose: the production routing is the defaults in
  // worker/channels.ts (DEFAULT_CHANNELS, ROUTES, INTERPRET_MODEL_DEFAULT),
  // next to the route flags that were measured for each model, so there is
  // one place to read and change it. Add a var here only to depart from a
  // default; `WorkerEnv` in worker/channels.ts lists every one, and GET
  // /api/health reports what is in effect. For example:
  //   "MINIMAX_CHANNEL": "opencode",   // MiniMax on the Go plan only
  //   "NO_STREAM": "deepseek",         // only if the account drops to the free plan
  // Every model must be vision-capable - verify with an image before
  // changing one (AGENTS.md). List what a key can see with:
  //   curl -H "Authorization: Bearer $POE_API_KEY" https://api.poe.com/v1/models
  //   OpenCode Go: GET https://opencode.ai/zen/go/v1/models
  "vars": {},
  // Every solve, interpretation step and cross-check runs in a TaskJob of
  // its own (worker/jobs.ts), so it finishes and keeps its answer for 24
  // hours even when the page that asked has gone away (a phone putting the
  // browser in the background). SQLite-backed: the class stores only the
  // task's final event, never the uploaded images.
  // PdfBudget (worker/pdf.ts): one object for the account, counting the
  // browser time PDFs used this month.
  "durable_objects": {
    "bindings": [
      { "name": "JOBS", "class_name": "TaskJob" },
      { "name": "PDF_BUDGET", "class_name": "PdfBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskJob"] },
    { "tag": "v2", "new_sqlite_classes": ["PdfBudget"] }
  ],
  // Browser Rendering: the headless Chrome that prints solutions to PDF
  // (GET /api/pdf/:id, worker/pdf.ts). Workers Paid includes 10 browser
  // hours a month, then US$0.09 an hour; PdfBudget stops at 9. "remote"
  // only matters to `npm run dev`: there is no local browser, so the dev
  // server uses Cloudflare's (it needs `npx wrangler login`).
  "browser": { "binding": "BROWSER", "remote": true },
  // Workers Rate Limiting: at most 20 model-calling requests (solve,
  // interpret, judge) per client IP per minute. One run with every option
  // on is about a dozen - eight solvers, two readers, a reconciler, a judge
  // - so this only stops a runaway client or script, never a real run
  // (people sharing one network share the limit). Re-attaching to a job and
  // cancelling one are not counted. The period can only be 10 or 60 s; the
  // namespace_id is any number unique to this limiter in the account.
  "ratelimits": [
    {
      "name": "TASK_LIMITER",
      "namespace_id": "2609",
      "simple": { "limit": 20, "period": 60 }
    },
    // At most 10 PDFs made per client IP per minute; one from the cache is
    // not counted.
    {
      "name": "PDF_LIMITER",
      "namespace_id": "2610",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
